#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Greg Wuller
# SPDX-License-Identifier: MIT
#
# Build a double-clickable FieldAssist.app and optionally install it for
# Finder and CLI use.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: script/bundle-macos [--install]

Build a macOS application bundle at target/release/FieldAssist.app.
Also builds release binaries for field-play and field-batch.

      --install   Copy the bundle to ~/Applications/FieldAssist.app,
                  symlink ~/.local/bin/FieldAssist and
                  ~/.local/bin/field-assist to the bundled binary, and
                  install release field-play / field-batch into
                  ~/.local/bin
  -h, --help      Show this help
EOF
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "error: script/bundle-macos only runs on macOS" >&2
  exit 1
fi

install=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --install)
      install=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

version="$(awk -F '"' '/^version = / { print $2; exit }' Cargo.toml)"
if [[ -z "$version" ]]; then
  echo "error: could not read version from Cargo.toml" >&2
  exit 1
fi

echo "Building FieldAssist ${version}, field-play, and field-batch (release)..."
cargo build --release -p FieldAssist -p field-play -p field-batch

binary="$root/target/release/FieldAssist"
field_play_bin="$root/target/release/field-play"
field_batch_bin="$root/target/release/field-batch"
for path in "$binary" "$field_play_bin" "$field_batch_bin"; do
  if [[ ! -x "$path" ]]; then
    echo "error: missing release binary: $path" >&2
    exit 1
  fi
done

app="$root/target/release/FieldAssist.app"
contents="$app/Contents"
macos_dir="$contents/MacOS"
resources="$contents/Resources"

rm -rf "$app"
mkdir -p "$macos_dir" "$resources"

sed "s/__VERSION__/${version}/g" \
  "$root/crates/field-assist/assets/macos/Info.plist" > "$contents/Info.plist"
printf 'APPL????' > "$contents/PkgInfo"
cp "$binary" "$macos_dir/FieldAssist"
chmod +x "$macos_dir/FieldAssist"

icon="$root/crates/field-assist/assets/app-icon/AppIcon.icns"
if [[ ! -f "$icon" ]]; then
  echo "error: missing $icon; run python script/generate-app-icon.py" >&2
  exit 1
fi
cp "$icon" "$resources/AppIcon.icns"

if ! plutil -lint "$contents/Info.plist" >/dev/null; then
  echo "error: generated Info.plist is invalid" >&2
  exit 1
fi

echo "Ad-hoc signing $app..."
codesign --force --deep --sign - "$app"

# Ensure Launch Services sees document types (Finder Open With / Dock drop).
lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [[ -x "$lsregister" ]]; then
  "$lsregister" -f "$app" >/dev/null 2>&1 || true
fi

echo "Created $app"

if [[ "$install" != true ]]; then
  exit 0
fi

app_dest="$HOME/Applications/FieldAssist.app"
bin_dir="$HOME/.local/bin"
cli_target="$app_dest/Contents/MacOS/FieldAssist"
cli_link="$bin_dir/FieldAssist"
cli_link_kebab="$bin_dir/field-assist"

mkdir -p "$HOME/Applications" "$bin_dir"
rm -rf "$app_dest"
ditto "$app" "$app_dest"
ln -sfn "$cli_target" "$cli_link"
ln -sfn "$cli_target" "$cli_link_kebab"

install -m 755 "$field_play_bin" "$bin_dir/field-play"
install -m 755 "$field_batch_bin" "$bin_dir/field-batch"

if [[ -x "$lsregister" ]]; then
  "$lsregister" -f "$app_dest" >/dev/null 2>&1 || true
fi

echo "Installed $app_dest"
echo "Linked $cli_link -> $cli_target"
echo "Linked $cli_link_kebab -> $cli_target"
echo "Installed $bin_dir/field-play"
echo "Installed $bin_dir/field-batch"

case ":$PATH:" in
  *":$bin_dir:"*)
    ;;
  *)
    cat <<EOF >&2
warning: $bin_dir is not on PATH.
Add the following to ~/.zshrc, then open a new terminal:

  export PATH="\$HOME/.local/bin:\$PATH"
EOF
    ;;
esac
