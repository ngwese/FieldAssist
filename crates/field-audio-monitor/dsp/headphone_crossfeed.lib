//
// Bauer / Linkwitz-style first-order headphone crossfeed (bs2b family).
// Applied to conventional L/R. Bypass is dry (no mix) when disabled.

import("stdfaust.lib");

crossfeed_enable = checkbox("Headphones/Crossfeed");
crossfeed_amount = hslider("Headphones/Amount", 0.35, 0, 1, 0.01) : si.smoo;
crossfeed_hz = hslider("Headphones/Crossover [unit:Hz][scale:log]",
                       700, 300, 2000, 1) : si.smoo;

crossfeed_fx(l, r) = l * dry + (r : lp : *(amt)),
                     r * dry + (l : lp : *(amt))
with {
    amt = crossfeed_amount;
    dry = 1 - 0.5 * amt;
    lp = fi.lowpass(1, crossfeed_hz);
};

headphone_crossfeed = ba.bypass2(1 - crossfeed_enable, crossfeed_fx);
