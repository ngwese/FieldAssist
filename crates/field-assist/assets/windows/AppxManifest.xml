  Template for the FieldAssist MSIX package. script/bundle-windows.ps1
  replaces __VERSION__ with the Cargo major.minor.patch.0 identity version.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop2 desktop6 rescap">

  <Identity
    Name="FieldAssist"
    Publisher="CN=FieldAssist"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FieldAssist</DisplayName>
    <PublisherDisplayName>FieldAssist</PublisherDisplayName>
    <Description>Review, edit, and process audio coming in from the field</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="FieldAssist" Executable="FieldAssist.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FieldAssist"
        Description="Review, edit, and process audio coming in from the field"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="FieldAssist.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="fieldassist-facomp">
            <uap:DisplayName>FieldAssist Composition</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.facomp</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="fieldassist-fasession">
            <uap:DisplayName>FieldAssist Session</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.fasession</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="fieldassist-audio">
            <uap:DisplayName>Audio</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.wave</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.oga</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.aiff</uap:FileType>
              <uap:FileType>.aif</uap:FileType>
              <uap:FileType>.caf</uap:FileType>
              <uap:FileType>.opus</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>

    <Application Id="FieldPlay" Executable="field-play.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="field-play"
        Description="FieldAssist CLI playback tool"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="field-play.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

    <Application Id="FieldBatch" Executable="field-batch.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="field-batch"
        Description="FieldAssist CLI batch scripting tool"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="field-batch.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
